#!/usr/bin/env bash
# Description: GitHub utilities (actions).

set -eo pipefail

usage() {
    echo "Usage: rautils github <subcommand>"
    echo ""
    echo "GitHub utilities."
    echo ""
    echo "Subcommands:"
    echo "  actions   Open the GitHub Actions page for the current repository"
    echo ""
    echo "Examples:"
    echo "  rautils github actions"
}

if [[ $# -lt 1 ]]; then
    usage
    exit 1
fi

# Output subcommand aliases for `rautils load`
if [[ "$1" == "--aliases" ]]; then
    echo "actions"
    exit 0
fi

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    usage
    exit 0
fi

SUBCOMMAND="$1"
shift

get_repo_https_url() {
    local remote_url
    remote_url=$(git remote get-url origin 2>/dev/null)

    if [[ -z "$remote_url" ]]; then
        echo "Error: No git remote 'origin' found." >&2
        return 1
    fi

    # Convert SSH URL to HTTPS
    if [[ "$remote_url" == git@* ]]; then
        remote_url="${remote_url/git@github.com:/https://github.com/}"
    fi

    # Remove .git suffix
    remote_url="${remote_url%.git}"

    echo "$remote_url"
}

case "$SUBCOMMAND" in
    actions)
        REPO_URL=$(get_repo_https_url) || exit 1
        ACTIONS_URL="${REPO_URL}/actions"
        echo "Opening $ACTIONS_URL"
        open "$ACTIONS_URL"
        ;;
    *)
        echo "Error: Unknown subcommand '$SUBCOMMAND'."
        echo ""
        usage
        exit 1
        ;;
esac
