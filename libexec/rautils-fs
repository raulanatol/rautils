#!/usr/bin/env bash
# Description: Filesystem utilities (folder-size).

set -eo pipefail

usage() {
    echo "Usage: rautils fs <subcommand> [path]"
    echo ""
    echo "Filesystem utilities."
    echo ""
    echo "Subcommands:"
    echo "  folder-size [path]   Show the size of a folder (defaults to current directory)"
    echo ""
    echo "Examples:"
    echo "  rautils fs folder-size"
    echo "  rautils fs folder-size ~/Projects"
}

if [[ $# -lt 1 ]]; then
    usage
    exit 1
fi

# Output subcommand aliases for `rautils load`
if [[ "$1" == "--aliases" ]]; then
    echo "folder-size"
    exit 0
fi

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    usage
    exit 0
fi

SUBCOMMAND="$1"
shift

case "$SUBCOMMAND" in
    folder-size)
        TARGET="${1:-.}"
        du -sh "$TARGET"
        ;;
    *)
        echo "Error: Unknown subcommand '$SUBCOMMAND'."
        echo ""
        usage
        exit 1
        ;;
esac
